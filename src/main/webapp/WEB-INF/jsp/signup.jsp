<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Sign up</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="auth"><p class="eyebrow">JOIN THE MARKET</p><h1>Create account</h1><% if(request.getAttribute("error")!=null){ %><div class="notice error">${error}</div><% } %><form method="post" action="/signup"><label>Username<input name="username" required minlength="3" placeholder="Choose a username"></label><label>Password<input type="password" name="password" required minlength="4" placeholder="At least 4 characters"></label><button class="button full">Create account</button></form><p>Already registered? <a href="/login">Log in</a></p><p class="muted">Demo note: accounts are stored in memory and reset when the app restarts.</p></main></body></html>
