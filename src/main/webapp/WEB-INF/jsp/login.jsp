<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Login</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="auth"><p class="eyebrow">WELCOME BACK</p><h1>Log in</h1><c:if test="${not empty error}"><div class="notice error">${error}</div></c:if><form method="post" action="/login"><label>Username<input name="username" required></label><label>Password<input type="password" name="password" required></label><button class="button full">Log in</button></form><p>New here? <a href="/signup">Create an account</a></p></main></body></html>
