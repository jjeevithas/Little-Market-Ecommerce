<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!DOCTYPE html><html><head><title>Checkout</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="auth checkout"><p class="eyebrow">ALMOST THERE</p><h1>Checkout</h1><h3>Order summary</h3><c:forEach var="item" items="${items}"><p>${item.product.name} × ${item.quantity} <strong class="right">₹${item.subtotal}</strong></p></c:forEach><div class="total"><span>Total</span><strong>₹${total}</strong></div><div class="notice">This starter project uses a simulated checkout. No card details are collected and no real payment is made.</div><form method="post" action="/checkout"><button class="button full">Place demo order</button></form><p><a href="/cart">← Return to cart</a></p></main></body></html>
