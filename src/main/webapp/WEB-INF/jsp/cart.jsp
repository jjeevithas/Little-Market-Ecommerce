<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!DOCTYPE html><html><head><title>Your cart</title><link rel="stylesheet" href="/css/style.css"></head><body><%@ include file="fragments/header.jspf" %><main class="wrap page"><p class="eyebrow">YOUR BAG</p><h1>Shopping cart</h1><c:choose><c:when test="${empty items}"><p class="empty">Your cart is empty. <a href="/products">Start shopping</a>.</p></c:when><c:otherwise><div class="cart-list"><c:forEach var="item" items="${items}"><div class="cart-row"><img src="${item.product.image}" alt=""><div class="cart-name"><h3>${item.product.name}</h3><small>₹${item.product.price} each</small></div><form action="/cart/update" method="post"><input type="hidden" name="productId" value="${item.product.id}"><input type="number" name="quantity" min="0" max="99" value="${item.quantity}"><button class="text-button">Update</button></form><strong>₹${item.subtotal}</strong><form action="/cart/remove" method="post"><input type="hidden" name="productId" value="${item.product.id}"><button class="text-button danger">Remove</button></form></div></c:forEach></div><div class="total"><span>Total</span><strong>₹${total}</strong></div><a class="button" href="/checkout">Continue to checkout</a></c:otherwise></c:choose></main></body></html>
