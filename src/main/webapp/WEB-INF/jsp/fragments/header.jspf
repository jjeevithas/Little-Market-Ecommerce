<%@ page contentType="text/html;charset=UTF-8" %>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/products">little<span>market</span></a>
<nav><a href="${pageContext.request.contextPath}/products">Shop</a>
<% if (session.getAttribute("user") != null) { %>
<a href="${pageContext.request.contextPath}/cart">Cart</a><a href="${pageContext.request.contextPath}/logout">Logout</a>
<% } else { %><a href="${pageContext.request.contextPath}/login">Login</a><a class="nav-cta" href="${pageContext.request.contextPath}/signup">Sign up</a><% } %>
</nav></header>
